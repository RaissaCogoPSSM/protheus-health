DATABASE_URL="postgresql://postgres:postgres@localhost:5437/protheus_health?schema=public"
PORT=3005

# Sync com o Protheus Monitor (TPH/updates) — disparado manualmente
# (POST /sync/updates), sem agendamento automático: o endpoint é lento.
TPH_UPDATES_URL="https://pssm-aplic-hml:8092/rest/protheusmonitor/tph/updates"
TPH_USERNAME=""
TPH_PASSWORD=""

# Se o endpoint usar certificado autoassinado/CA interna (comum em homologação),
# NÃO desabilite a verificação TLS no código. Aponte para o certificado da CA
# interna em formato PEM: o Node vai confiar nele automaticamente.
# NODE_EXTRA_CA_CERTS="C:/caminho/para/ca-interna.pem"

# Conexão direta (SQL Server) com o banco do Protheus, para ler a SX6010
# (parâmetros/MV_*). Sync manual via POST /sync/params; a primeira carga
# grava tudo, depois disso roda sozinho todo dia à meia-noite.
PROTHEUS_DB_HOST=""
PROTHEUS_DB_PORT=1433
PROTHEUS_DB_DATABASE=""
PROTHEUS_DB_USER=""
PROTHEUS_DB_PASSWORD=""
# "false" só se a instância não usar TLS; manter "true" é o padrão seguro.
PROTHEUS_DB_ENCRYPT="true"
# "true" apenas se a instância usar certificado autoassinado e você não
# tiver como configurar uma CA confiável (NODE_EXTRA_CA_CERTS acima).
PROTHEUS_DB_TRUST_CERT="false"
